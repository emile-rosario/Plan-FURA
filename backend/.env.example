# ── Seguridad ──────────────────────────────────────────────────────
# Genera una clave segura con: openssl rand -hex 32
SECRET_KEY=CAMBIA_ESTA_CLAVE

# ── Base de datos PostgreSQL ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=funeraria_rancier
DB_USER=funeraria_user
DB_PASSWORD=funeraria_pass

# ── Email (Resend) ─────────────────────────────────────────────────
# Obtén tu API key en: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Funerarias Rancier <noreply@tudominio.com>

# ── URLs ───────────────────────────────────────────────────────────
FRONTEND_URL=http://127.0.0.1:5500
BACKEND_URL=http://localhost:8000

# ── App ────────────────────────────────────────────────────────────
APP_ENV=development
