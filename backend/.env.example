# Funeraria Rancier — Variables de entorno
# Copia este archivo como .env y ajusta los valores

# ── Seguridad ─────────────────────────────────────────────────
SECRET_KEY=cambia_esto_en_produccion_openssl_rand_hex_32
ADMIN_PASSWORD=CambiaEstaClave@2025!

# ── Base de datos ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=funeraria_rancier
DB_USER=funeraria_user
DB_PASSWORD=funeraria_pass

# ── Hosts permitidos (TrustedHostMiddleware) ──────────────────
ALLOWED_HOSTS=localhost,127.0.0.1,tudominio.com

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,https://tudominio.com

# ── Email / SMTP ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu@gmail.com
SMTP_PASSWORD=tu_app_password
SMTP_FROM=noreply@funerariarancier.com

# ── Frontend ──────────────────────────────────────────────────
FRONTEND_URL=https://tudominio.com

# ── App ───────────────────────────────────────────────────────
APP_ENV=production
